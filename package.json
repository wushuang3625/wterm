{
  "name": "wterm",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "description": "wterm — 开源、轻量、设计驱动的 SSH 工作台",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "dev:web": "vite",
    "dev:desktop": "node scripts/build-desktop.mjs --dev",
    "build:web": "npm run typecheck && vite build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:explorer": "node scripts/build-explorer.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:web": "node --test tests/*.test.mjs",
    "test:ssh": "cargo test --manifest-path src-tauri/Cargo.toml ssh_auth --lib",
    "test:ui": "playwright test",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "zmodem.js": "^0.1.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.0.0",
    "ssh2": "^1.17.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  }
}
